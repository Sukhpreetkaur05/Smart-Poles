# =========================
# SAFE STREET AI - TEMPORARY SENDER EMAIL
# =========================
# A fresh disposable mailbox is created when an alert is sent.
# It acts as the FROM/SENDER address. The mailbox is requested to be
# deleted automatically a few seconds after a successful send.

EMAIL_ENABLED=1
TEMP_SENDER_ENABLED=1
TEMP_SENDER_DELETE=1
TEMP_SENDER_DELETE_DELAY=5

# Where YOU want to receive the SOS alert.
# Use your normal Gmail/Outlook address; phone notification depends on your mail app.
SOS_TO_EMAIL=your_email@gmail.com

# NenzMail API (no key required for the documented free send flow at the time of this project)
NENZMAIL_API=https://api.nenzmail.com/api

# Optional authorized control-room webhook
ALERT_WEBHOOK_URL=

# Webcam / AI options
CAMERA_INDEX=0
CONF=0.35
IMG_SIZE=640
PROCESS_EVERY_N=1
MODEL_NAME=yolo26n-pose.pt
